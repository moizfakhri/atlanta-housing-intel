# Copy to .env and populate locally. NEVER commit .env to GitHub.

# Free US Census Bureau API key: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Free FRED API key (Federal Reserve mortgage rates & macro): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Optional (Path B - Streetscape): Free Mapillary Graph API token
MAPILLARY_ACCESS_TOKEN=

# Optional (Path A/B/E - LLM Spatial Agent / VLM / Rezoning extraction)
GEMINI_API_KEY=
